     public:
         explicit ThreadPool(size_t num_threads = std::thread::hardware_concurrency())
             : stop(false), pending_tasks(0) {
+            // Backport the reviewed v2.2.2 evaluation thread-count control.
+            if (const char* env_threads = std::getenv("CACTUS_NUM_THREADS")) {
+                char* end = nullptr;
+                unsigned long requested = std::strtoul(env_threads, &end, 10);
+                if (end != env_threads && requested > 0) {
+                    num_threads = static_cast<size_t>(requested);
+                }
+            }
             num_workers_ = std::min(num_threads, MAX_WORKERS);
             if (num_workers_ == 0) num_workers_ = 1;
 
--- a/cactus/telemetry/telemetry_local_only.cpp
+++ b/cactus/telemetry/telemetry_local_only.cpp
@@ -0,0 +1,26 @@
+// Local personal evaluation build: no telemetry, persisted identifiers or cloud keys.
+#include "telemetry.h"
+#include "../kernel/kernel_utils.h"
+extern "C" bool cactus_memoryos_evaluation_is_local_only(void) { return true; }
+extern "C" size_t cactus_memoryos_evaluation_thread_count(void) { return CactusThreading::get_thread_pool().num_workers(); }
+namespace cactus::telemetry {
+void init(const char*, const char*, const char*) {}
+void setEnabled(bool) {}
+void setCloudDisabled(bool) {}
+void setAppId(const char*) {}
+void setTelemetryEnvironment(const char*, const char*, const char*) {}
+void setCloudKey(const char*) {}
+void cacheCloudApiKey(const char*) {}
+std::string loadCachedCloudApiKey() { return {}; }
+void recordInit(const char*, bool, double, const char*) {}
+void recordCompletion(const char*, const CompletionMetrics&) {}
+void recordCompletion(const char*, bool, double, double, double, int, const char*) {}
+void recordEmbedding(const char*, bool, const char*) {}
+void recordTranscription(const char*, bool, double, double, double, int, double, const char*) {}
+void recordStreamTranscription(const char*, bool, double, double, double, int, double, double, double, int, const char*) {}
+void setStreamMode(bool) {}
+bool isStreamMode() { return false; }
+void markInference(bool) {}
+void flush() {}
+void shutdown() {}
+}
