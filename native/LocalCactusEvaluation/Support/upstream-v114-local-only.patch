--- a/cactus/ffi/cactus_memoryos_embedding.cpp
+++ b/cactus/ffi/cactus_memoryos_embedding.cpp
@@ -0,0 +1,48 @@
+// Explicit Qwen3 Embedding preprocessing for this local evaluation.
+// Model card: https://huggingface.co/Qwen/Qwen3-Embedding-0.6B#transformers-usage
+// Use the final unpadded token's hidden state, then L2-normalize that row.
+// The upstream cactus_embed mean-pooling API remains unchanged.
+#include "cactus_ffi.h"
+#include "cactus_utils.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+#if defined(CACTUS_LOCAL_EVALUATION_ONLY)
+extern "C" int cactus_memoryos_evaluation_embed_last_token(
+    cactus_model_t model, const char* text, float* buffer, size_t buffer_size,
+    size_t* embedding_dim, bool normalize) {
+    using namespace cactus::ffi;
+    if (!model || !text || !buffer || buffer_size == 0) return -1;
+    try {
+        auto* handle = static_cast<CactusModelHandle*>(model);
+        auto* tokenizer = handle->model->get_tokenizer();
+        if (!tokenizer) return -1;
+        const auto tokens = tokenizer->encode(text);
+        if (tokens.empty()) return -1;
+        const auto hidden = handle->model->get_embeddings(tokens, false, false);
+        if (hidden.empty() || hidden.size() % tokens.size() != 0) return -1;
+        const size_t dimension = hidden.size() / tokens.size();
+        if (dimension > buffer_size / sizeof(float)) return -2;
+        const size_t offset = hidden.size() - dimension;
+        double sum = 0.0;
+        for (size_t i = offset; i < hidden.size(); ++i) {
+            if (!std::isfinite(hidden[i])) return -1;
+            sum += static_cast<double>(hidden[i]) * hidden[i];
+        }
+        const double norm = std::sqrt(sum);
+        if (normalize && !(norm > 1e-12)) return -1;
+        for (size_t i = 0; i < dimension; ++i) {
+            buffer[i] = normalize ? static_cast<float>(hidden[offset + i] / norm) : hidden[offset + i];
+        }
+        if (embedding_dim) *embedding_dim = dimension;
+        return static_cast<int>(dimension);
+    } catch (const std::exception& error) {
+        last_error_message = error.what();
+        return -1;
+    } catch (...) {
+        last_error_message = "Unknown last-token embedding failure";
+        return -1;
+    }
+}
+#endif
